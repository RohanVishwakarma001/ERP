# ─────────────────────────────────────────────────────────────────────────────
# JBIT Campus ERP — backend environment
# Copy to `.env` and fill in. Every variable is validated at boot by
# src/config/env.validation.ts — the server refuses to start if a required
# value is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development            # development | test | production
PORT=8000

# Clients & CORS
WEB_URL=http://localhost:3000   # required; the web app's origin
CORS_ORIGINS=                   # extra comma-separated browser origins allowed in production
ENABLE_SWAGGER=false            # Swagger UI is always on outside production; set true to expose it in production
TRUST_PROXY=0                   # reverse-proxy hops in front of the API (Render/Railway/Nginx: 1); keeps rate limits per real client IP

# Database (PostgreSQL) — required
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jbit_campus_erp?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/jbit_campus_erp?schema=public

# Auth — required, must differ; min 32 chars (48 in production, and placeholders are rejected). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# The web app's JWT_ACCESS_SECRET (web/.env.local) must equal this one.
JWT_ACCESS_SECRET=replace-with-a-generated-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-generated-random-secret

# ── Administrator accounts ───────────────────────────────────────────────────
# Created on first boot and kept in sync with these values on every restart:
# change an email (the login) or password here and restart the API to apply it.
# A password change signs that account out everywhere. Removing an account's
# variables disables it. Passwords need 8–72 chars with upper, lower, digit, symbol.
# SUPER_ADMIN is required in production. Every other account (students, faculty,
# staff) is created by an admin in the app under Admin → Users.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Optional integrations ────────────────────────────────────────────────────
# Each is disabled (with a startup warning) while unset or left as a placeholder.

# Email (SMTP). Disabled → OTP emails are skipped and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JBIT ERP <erp@jbitdoon.edu.in>"

# File storage (Cloudinary). Disabled → POST /uploads returns 503.
STORAGE_BUCKET=                 # Cloudinary cloud name
STORAGE_ACCESS_KEY=             # API key
STORAGE_SECRET_KEY=             # API secret

# Payments (Razorpay). Disabled → /fees/orders, /fees/verify, /fees/webhook return 503.
# Keys: https://dashboard.razorpay.com/app/keys. Register the webhook at
# POST {API_URL}/api/v1/fees/webhook for payment.captured and order.paid.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

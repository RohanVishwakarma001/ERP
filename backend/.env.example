# Environment Configuration
NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# Web & Mobile Client URLs
WEB_URL=http://localhost:3000
MOBILE_APP_SCHEME=jbit-erp://
# Comma-separated list of additional browser origins allowed by CORS (beyond WEB_URL)
CORS_ORIGINS=
# Set to "true" to expose Swagger UI (/api/docs) when NODE_ENV=production. Never enable on a public prod deployment.
ENABLE_SWAGGER=false

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jbit_campus_erp?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/jbit_campus_erp?schema=public

# Redis Configuration (BullMQ & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT Authentication — generate real values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# There is no built-in fallback: the app refuses to start without these set (min 32 chars).
JWT_ACCESS_SECRET=replace-with-a-generated-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-a-different-generated-random-secret
JWT_REFRESH_EXPIRATION=7d

# File Storage (S3 / Cloudinary / Local abstraction)
STORAGE_PROVIDER=local
STORAGE_BUCKET=jbit-campus-erp-storage
STORAGE_ACCESS_KEY=mock-key
STORAGE_SECRET_KEY=mock-secret
STORAGE_REGION=ap-south-1

# Payment Gateway (Razorpay) — real integration, but inert until real keys are set.
# Get these from https://dashboard.razorpay.com/app/keys (test mode is fine to start).
# The webhook secret comes from Settings > Webhooks when you register the endpoint
# POST {WEB_URL}/api/v1/fees/webhook with the payment.captured / order.paid events.
# Leaving these as the placeholder "...mock..." values below makes /fees/orders and
# /fees/webhook return 503 rather than silently pretending to work.
PAYMENT_KEY_ID=rzp_test_mock_jbit_2026
PAYMENT_KEY_SECRET=rzp_sec_mock_jbit_2026
PAYMENT_WEBHOOK_SECRET=rzp_wh_mock_jbit_2026

# SMTP / Email Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock-user
SMTP_PASSWORD=mock-pass
SMTP_FROM="JBIT ERP <erp@jbitdoon.edu.in>"

# AI Assistant Provider
AI_PROVIDER=jbit-grounded-copilot
AI_API_KEY=mock-ai-key-do-not-expose

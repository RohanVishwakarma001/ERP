{
  "expo": {
    "name": "JBIT Campus ERP",
    "slug": "jbit-campus-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jbitcampus",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "edu.jbitdoon.campuserp",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "JBIT Campus ERP requires camera access to scan classroom QR codes for instant attendance verification.",
        "NSFaceIDUsageDescription": "Enable biometric verification for fast and secure access to your institutional records.",
        "NSLocationWhenInUseUsageDescription": "JBIT Campus ERP uses your location to confirm you are inside the classroom geofence when marking QR attendance."
      }
    },
    "android": {
      "package": "edu.jbitdoon.campuserp",
      "adaptiveIcon": {
        "backgroundColor": "#002541",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JBIT Campus ERP uses your location to confirm you are inside the classroom geofence when marking QR attendance."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002541",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

# When using Expo Go on a physical phone, replace localhost with your computer's Wi-Fi IPv4 address (e.g. 192.168.x.x)
# The mobile client will also automatically auto-detect the Metro bundler host IP.
EXPO_PUBLIC_API_URL=http://192.168.31.129:8000/api/v1
EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_APP_NAME="JBIT Campus ERP"
# Web portal origin (e.g. https://erp.jbitdoon.edu.in). Enables "Pay fees" and "Forgot password?" links. Optional.
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_CAMPUS="Dehradun, Uttarakhand"

# Dev builds only: fills the password for the "DEV TEST CREDENTIALS" chips on the
# login screen. Must equal backend SEED_DEFAULT_PASSWORD. Leave empty otherwise.
EXPO_PUBLIC_DEV_SEED_PASSWORD=
